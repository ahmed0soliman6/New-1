rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================
    // HELPER FUNCTIONS — SINGLE SOURCE OF TRUTH (RBAC & ABAC)
    // =============================================================

    function signedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isUserActive() {
      let u = getUserDoc();
      return signedIn() && (u == null || u.active != false);
    }

    function getUserRole() {
      let u = getUserDoc();
      return u != null && u.role != null ? u.role : 'SECRETARY';
    }

    function isAdmin() {
      let role = getUserRole();
      return signedIn() && isUserActive() && (
        role == 'ADMIN' ||
        role == 'admin' ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.matches('.*admin.*'))
      );
    }

    function isDoctor() {
      let role = getUserRole();
      return signedIn() && isUserActive() && (
        isAdmin() ||
        role == 'DOCTOR' ||
        role == 'doctor' ||
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null && request.auth.token.email.matches('.*(doctor|dr).*'))
      );
    }

    // Role default permissions when customPermissions is not explicitly configured
    function roleDefaultPermission(role, screen, action) {
      let r = (role == 'ADMIN' || role == 'admin') ? 'admin'
            : (role == 'DOCTOR' || role == 'doctor') ? 'doctor'
            : 'secretary';

      return r == 'admin' ? true
        : r == 'doctor' ? (
            (screen in ['dashboard', 'clinical-reports'] && action == 'view') ||
            (screen in ['waiting-queue'] && (action in ['view', 'update'])) ||
            (screen in ['clinical-exam', 'upcoming-followups', 'appointments'] && (action in ['view', 'create', 'update', 'delete'])) ||
            (screen in ['new-visit', 'visits', 'patient-records', 'patients', 'prescription-pad', 'prescriptions'] && (action in ['view', 'create', 'update'])) ||
            (screen in ['billing-payments', 'finance', 'system-settings', 'settings', 'medicalCatalogs'] && action == 'view')
          )
        : ( // secretary defaults
            (screen in ['dashboard', 'clinical-reports'] && action == 'view') ||
            (screen in ['new-visit', 'visits', 'patient-records', 'patients', 'waiting-queue', 'billing-payments', 'finance', 'expenses'] && (action in ['view', 'create', 'update'])) ||
            (screen in ['upcoming-followups', 'appointments'] && (action in ['view', 'create', 'update', 'delete'])) ||
            (screen in ['prescription-pad', 'prescriptions'] && action == 'view')
          );
    }

    // Dynamic Permission Checker: checks customPermissions -> fallback allowedScreens -> fallback role
    function hasPermission(screen, action) {
      let u = getUserDoc();
      return signedIn() && isUserActive() && (
        isAdmin() ||
        (
          u != null &&
          u.customPermissions != null &&
          screen in u.customPermissions &&
          action in u.customPermissions[screen] &&
          u.customPermissions[screen][action] == true
        ) ||
        (
          u != null &&
          (
            u.customPermissions == null ||
            !(screen in u.customPermissions) ||
            !(action in u.customPermissions[screen])
          ) &&
          (
            // If action is view and allowedScreens array is populated, check screen inclusion
            (action == 'view' && u.allowedScreens != null && u.allowedScreens is list && screen in u.allowedScreens) ||
            // Fallback to role-based default permission
            roleDefaultPermission(getUserRole(), screen, action)
          )
        ) ||
        (
          u == null && roleDefaultPermission('secretary', screen, action)
        )
      );
    }

    // =============================================================
    // 1. USERS & ACCESS CONTROL (CRITICAL: ADMIN PROTECTION)
    // =============================================================
    match /users/{userId} {
      // All authenticated users can read users for profile and collaborator lookups
      allow read: if signedIn();

      // Creation allowed during initial bootstrap or by Admin
      allow create: if signedIn() && (isAdmin() || request.auth.uid == userId);

      // Updates: Admin has full access; normal user CANNOT escalate role or permissions
      allow update: if signedIn() && (
        isAdmin() || (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'customPermissions', 'allowedScreens', 'active', 'createdBy'])
        )
      );

      // Deletion strictly limited to Admin, and Admin cannot delete their own active account
      allow delete: if signedIn() && isAdmin() && request.auth.uid != userId;
    }

    // =============================================================
    // 2. USERNAMES DIRECTORY
    // =============================================================
    match /usernames/{usernameLower} {
      allow get: if true; // Single doc lookup for username resolution on login
      allow list: if signedIn();
      allow create, update: if signedIn() && (isAdmin() || request.resource.data.uid == request.auth.uid);
      allow delete: if signedIn() && isAdmin();
    }

    // =============================================================
    // 3. SYSTEM BOOTSTRAP & PBKDF2 ADMIN RECOVERY
    // =============================================================
    match /_system/bootstrap {
      allow get: if true; // Single doc lookup for bootstrap state check
      allow list: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /_system/recovery {
      allow get: if true; // Single doc lookup for PBKDF2 verification before login
      allow list: if signedIn();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['hash', 'salt', 'createdAt', 'updatedAt', 'attempts', 'lockedUntil', 'envelope', 'iv', 'lastRecoveredAt'])
      );
      allow update: if isAdmin() || (
        resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts', 'lockedUntil', 'envelope', 'iv', 'lastRecoveredAt'])
      );
      allow delete: if false; // Recovery document should never be deleted
    }

    // =============================================================
    // 4. PATIENT RECORDS (EMR)
    // =============================================================
    match /patients/{patientId} {
      allow read: if hasPermission('patient-records', 'view') || hasPermission('patients', 'view') || hasPermission('new-visit', 'view');
      allow create: if hasPermission('patient-records', 'create') || hasPermission('patients', 'create') || hasPermission('new-visit', 'create');
      allow update: if hasPermission('patient-records', 'update') || hasPermission('patients', 'update') || hasPermission('new-visit', 'update');
      allow delete: if hasPermission('patient-records', 'delete') || hasPermission('patients', 'delete');
    }

    // =============================================================
    // 5. APPOINTMENTS & SCHEDULING
    // =============================================================
    match /appointments/{appointmentId} {
      allow read: if hasPermission('upcoming-followups', 'view') || hasPermission('appointments', 'view') || hasPermission('new-visit', 'view');
      allow create: if hasPermission('upcoming-followups', 'create') || hasPermission('appointments', 'create') || hasPermission('new-visit', 'create');
      allow update: if hasPermission('upcoming-followups', 'update') || hasPermission('appointments', 'update') || hasPermission('new-visit', 'update') || hasPermission('waiting-queue', 'update');
      allow delete: if hasPermission('upcoming-followups', 'delete') || hasPermission('appointments', 'delete');
    }

    // =============================================================
    // 6. CLINICAL VISITS & QUEUE ENCOUNTERS
    // =============================================================
    match /visits/{visitId} {
      allow read: if hasPermission('waiting-queue', 'view') || hasPermission('new-visit', 'view') || hasPermission('clinical-exam', 'view') || hasPermission('patient-records', 'view');
      allow create: if hasPermission('new-visit', 'create') || hasPermission('waiting-queue', 'create');
      allow update: if hasPermission('waiting-queue', 'update') || hasPermission('clinical-exam', 'update') || hasPermission('new-visit', 'update');
      allow delete: if hasPermission('new-visit', 'delete') || hasPermission('waiting-queue', 'delete') || hasPermission('clinical-exam', 'delete');
    }

    // =============================================================
    // 7. INVOICES & BILLING STATEMENTS
    // =============================================================
    match /invoices/{invoiceId} {
      allow read: if hasPermission('billing-payments', 'view') || hasPermission('finance', 'view') || hasPermission('new-visit', 'view');
      allow create: if hasPermission('billing-payments', 'create') || hasPermission('finance', 'create') || hasPermission('new-visit', 'create');
      allow update: if hasPermission('billing-payments', 'update') || hasPermission('finance', 'update') || hasPermission('new-visit', 'update');
      allow delete: if hasPermission('billing-payments', 'delete') || hasPermission('finance', 'delete');
    }

    // =============================================================
    // 8. PAYMENTS & CASH COLLECTION
    // =============================================================
    match /payments/{paymentId} {
      allow read: if hasPermission('billing-payments', 'view') || hasPermission('finance', 'view') || hasPermission('new-visit', 'view');
      allow create: if hasPermission('billing-payments', 'create') || hasPermission('finance', 'create') || hasPermission('new-visit', 'create');
      allow update: if hasPermission('billing-payments', 'update') || hasPermission('finance', 'update') || hasPermission('new-visit', 'update');
      allow delete: if hasPermission('billing-payments', 'delete') || hasPermission('finance', 'delete');
    }

    // =============================================================
    // 9. FINANCIAL TRANSACTIONS & EXPENSES
    // =============================================================
    match /transactions/{transactionId} {
      allow read: if hasPermission('billing-payments', 'view') || hasPermission('finance', 'view') || hasPermission('expenses', 'view');
      allow create: if hasPermission('billing-payments', 'create') || hasPermission('finance', 'create') || hasPermission('expenses', 'create');
      allow update: if hasPermission('billing-payments', 'update') || hasPermission('finance', 'update') || hasPermission('expenses', 'update');
      allow delete: if hasPermission('billing-payments', 'delete') || hasPermission('finance', 'delete') || hasPermission('expenses', 'delete');
    }

    match /expenses/{expenseId} {
      allow read: if hasPermission('billing-payments', 'view') || hasPermission('finance', 'view') || hasPermission('expenses', 'view');
      allow create: if hasPermission('billing-payments', 'create') || hasPermission('finance', 'create') || hasPermission('expenses', 'create');
      allow update: if hasPermission('billing-payments', 'update') || hasPermission('finance', 'update') || hasPermission('expenses', 'update');
      allow delete: if hasPermission('billing-payments', 'delete') || hasPermission('finance', 'delete') || hasPermission('expenses', 'delete');
    }

    match /expenseCategories/{categoryId} {
      allow read: if isUserActive();
      allow create, update, delete: if isAdmin() || hasPermission('system-settings', 'update') || hasPermission('billing-payments', 'create');
    }

    // =============================================================
    // 10. PRESCRIPTIONS & MEDICATION ORDERS
    // =============================================================
    match /prescriptions/{prescriptionId} {
      allow read: if hasPermission('clinical-exam', 'view') || hasPermission('prescription-pad', 'view') || hasPermission('prescriptions', 'view') || hasPermission('patient-records', 'view');
      allow create: if hasPermission('clinical-exam', 'create') || hasPermission('prescription-pad', 'create') || hasPermission('prescriptions', 'create');
      allow update: if hasPermission('clinical-exam', 'update') || hasPermission('prescription-pad', 'update') || hasPermission('prescriptions', 'update');
      allow delete: if hasPermission('clinical-exam', 'delete') || hasPermission('prescription-pad', 'delete') || hasPermission('prescriptions', 'delete');
    }

    // =============================================================
    // 11. FOLLOW-UPS & REVIEWS
    // =============================================================
    match /followUps/{followUpId} {
      allow read: if hasPermission('upcoming-followups', 'view') || hasPermission('clinical-exam', 'view');
      allow create: if hasPermission('clinical-exam', 'create') || hasPermission('upcoming-followups', 'create');
      allow update: if hasPermission('upcoming-followups', 'update') || hasPermission('clinical-exam', 'update');
      allow delete: if hasPermission('upcoming-followups', 'delete') || hasPermission('clinical-exam', 'delete');
    }

    // =============================================================
    // 12. DIAGNOSTICS: LAB ORDERS & RADIOLOGY ORDERS
    // =============================================================
    match /labOrders/{labOrderId} {
      allow read: if hasPermission('clinical-exam', 'view') || hasPermission('patient-records', 'view');
      allow create: if hasPermission('clinical-exam', 'create');
      allow update: if hasPermission('clinical-exam', 'update');
      allow delete: if hasPermission('clinical-exam', 'delete');
    }

    match /radiologyOrders/{radiologyOrderId} {
      allow read: if hasPermission('clinical-exam', 'view') || hasPermission('patient-records', 'view');
      allow create: if hasPermission('clinical-exam', 'create');
      allow update: if hasPermission('clinical-exam', 'update');
      allow delete: if hasPermission('clinical-exam', 'delete');
    }

    // =============================================================
    // 13. MEDICAL CATALOGS (DIAGNOSES, SYMPTOMS, DRUGS, LABS, RAD)
    // =============================================================
    match /medications/{medicationId} {
      allow read: if isUserActive();
      allow create: if hasPermission('system-settings', 'create') || hasPermission('medicalCatalogs', 'create');
      allow update: if hasPermission('system-settings', 'update') || hasPermission('medicalCatalogs', 'update');
      allow delete: if hasPermission('system-settings', 'delete') || hasPermission('medicalCatalogs', 'delete');
    }

    match /labTests/{labTestId} {
      allow read: if isUserActive();
      allow create: if hasPermission('system-settings', 'create') || hasPermission('medicalCatalogs', 'create');
      allow update: if hasPermission('system-settings', 'update') || hasPermission('medicalCatalogs', 'update');
      allow delete: if hasPermission('system-settings', 'delete') || hasPermission('medicalCatalogs', 'delete');
    }

    match /radiologyTypes/{radiologyTypeId} {
      allow read: if isUserActive();
      allow create: if hasPermission('system-settings', 'create') || hasPermission('medicalCatalogs', 'create');
      allow update: if hasPermission('system-settings', 'update') || hasPermission('medicalCatalogs', 'update');
      allow delete: if hasPermission('system-settings', 'delete') || hasPermission('medicalCatalogs', 'delete');
    }

    match /diagnoses/{diagnosisId} {
      allow read: if isUserActive();
      allow create: if hasPermission('system-settings', 'create') || hasPermission('medicalCatalogs', 'create');
      allow update: if hasPermission('system-settings', 'update') || hasPermission('medicalCatalogs', 'update');
      allow delete: if hasPermission('system-settings', 'delete') || hasPermission('medicalCatalogs', 'delete');
    }

    match /symptoms/{symptomId} {
      allow read: if isUserActive();
      allow create: if hasPermission('system-settings', 'create') || hasPermission('medicalCatalogs', 'create');
      allow update: if hasPermission('system-settings', 'update') || hasPermission('medicalCatalogs', 'update');
      allow delete: if hasPermission('system-settings', 'delete') || hasPermission('medicalCatalogs', 'delete');
    }

    match /chronicDiseases/{diseaseId} {
      allow read: if isUserActive();
      allow create: if hasPermission('system-settings', 'create') || hasPermission('medicalCatalogs', 'create');
      allow update: if hasPermission('system-settings', 'update') || hasPermission('medicalCatalogs', 'update');
      allow delete: if hasPermission('system-settings', 'delete') || hasPermission('medicalCatalogs', 'delete');
    }

    // =============================================================
    // 14. SERVICES & PROCEDURES PRICING
    // =============================================================
    match /services/{serviceId} {
      allow read: if isUserActive();
      allow create: if hasPermission('system-settings', 'create') || hasPermission('billing-payments', 'create');
      allow update: if hasPermission('system-settings', 'update') || hasPermission('billing-payments', 'update');
      allow delete: if hasPermission('system-settings', 'delete') || hasPermission('billing-payments', 'delete');
    }

    // =============================================================
    // 15. CLINIC LOCATIONS, DOCTOR PROFILE & SETTINGS
    // =============================================================
    match /clinicLocations/{locationId} {
      allow read: if isUserActive();
      allow create, update, delete: if isAdmin() || hasPermission('system-settings', 'update');
    }

    match /doctorProfile/{profileId} {
      allow read: if isUserActive();
      allow create, update, delete: if isAdmin() || isDoctor() || hasPermission('system-settings', 'update');
    }

    match /doctorSettings/{settingId} {
      allow read: if isUserActive();
      allow create, update, delete: if isAdmin() || isDoctor() || hasPermission('system-settings', 'update');
    }

    match /systemSettings/{settingId} {
      allow read: if isUserActive();
      allow create, update: if isAdmin() || hasPermission('system-settings', 'update');
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isUserActive();
      allow create, update: if isAdmin() || hasPermission('system-settings', 'update') || hasPermission('prescription-pad', 'update');
      allow delete: if isAdmin();
    }

    // =============================================================
    // 16. ATOMIC COUNTERS & SEQUENCES
    // =============================================================
    match /counters/{counterId} {
      allow read: if isUserActive();
      allow create, update: if isUserActive() && (
        hasPermission('new-visit', 'create') ||
        hasPermission('upcoming-followups', 'update') ||
        hasPermission('waiting-queue', 'create') ||
        hasPermission('waiting-queue', 'update')
      );
      allow delete: if isAdmin();
    }

    // =============================================================
    // FALLBACK: ZERO-TRUST DEFAULT DENY
    // =============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
