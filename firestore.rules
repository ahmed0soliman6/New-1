rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }
    function isAdmin() {
      return signedIn() && (
        userRole() == 'ADMIN' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*'))
      );
    }
    function isDoctor() {
      return signedIn() && (
        userRole() == 'DOCTOR' ||
        isAdmin() ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*(doctor|dr).*'))
      );
    }
    function isSecretary() {
      return signedIn() && (
        userRole() == 'SECRETARY' ||
        isAdmin() ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*(sec|reception).*'))
      );
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn() && (isAdmin() || request.auth.uid == userId);
      allow delete: if signedIn() && isAdmin();
    }
    match /usernames/{usernameLower} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if signedIn() && isAdmin();
    }
    match /_system/{document} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /patients/{patientId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && (isAdmin() || isDoctor());
    }
    match /appointments/{appointmentId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && (isAdmin() || isSecretary());
    }
    match /visits/{visitId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && isAdmin();
    }
    match /invoices/{invoiceId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && isAdmin();
    }
    match /payments/{paymentId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && isAdmin();
    }
    match /prescriptions/{prescriptionId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && isAdmin();
    }
    match /followUps/{followUpId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && isAdmin();
    }
    match /labOrders/{labOrderId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && isAdmin();
    }
    match /radiologyOrders/{radiologyOrderId} {
      allow read, create, update: if signedIn();
      allow delete: if signedIn() && isAdmin();
    }
    match /medications/{medicationId} {
      allow read, create, update, delete: if signedIn();
    }
    match /labTests/{labTestId} {
      allow read, create, update, delete: if signedIn();
    }
    match /radiologyTypes/{radiologyTypeId} {
      allow read, create, update, delete: if signedIn();
    }
    match /diagnoses/{diagnosisId} {
      allow read, create, update, delete: if signedIn();
    }
    match /symptoms/{symptomId} {
      allow read, create, update, delete: if signedIn();
    }
    match /chronicDiseases/{diseaseId} {
      allow read, create, update, delete: if signedIn();
    }
    match /counters/{counterId} {
      allow read, write: if signedIn();
    }
    match /settings/{settingId} {
      allow read, write: if signedIn();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
